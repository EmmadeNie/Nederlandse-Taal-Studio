{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "redirects": [
    {
      "source": "/contact",
      "destination": "/nederlandse-les/#contact",
      "permanent": true
    },
    {
      "source": "/contact/",
      "destination": "/nederlandse-les/#contact",
      "permanent": true
    }
  ]
}
